# Staging reverse proxy for sticker-service.
#
# Rendered by the official nginx image entrypoint via envsubst
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only ${STAGING_DOMAIN}
# is substituted; nginx $variables are left untouched.
#
# TLS: this config serves plain HTTP on the compose-internal network and is
# published only on 127.0.0.1:8015. TLS is terminated by the HOST nginx once
# the STAGING_DOMAIN DNS record resolves (server block + certbot on the host,
# proxying to 127.0.0.1:8015). Nothing TLS-related belongs in this container.

upstream sticker_backend {
    server backend:8000;
}

server {
    listen 80;
    server_name ${STAGING_DOMAIN};

    # Order photos can be up to ORDER_PHOTO_MAX_BYTES (20 MB by default).
    client_max_body_size 25m;

    location /static/ {
        alias /usr/share/nginx/static/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /health/ {
        proxy_pass http://sticker_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Webhook endpoints — listed explicitly so they keep working even if the
    # catch-all below is ever restricted.
    location /telegram/webhook/ {
        proxy_pass http://sticker_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /max/webhook/ {
        proxy_pass http://sticker_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /max/payment/webhook/ {
        proxy_pass http://sticker_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else (/admin/, DRF API, ...).
    # Production Console actions run one synchronous image generation per
    # request (preview / revision / one FULL slot, measured 60-90 s on
    # staging). nginx's 60 s default returned 504 to the operator while the
    # job completed; keep this in step with gunicorn --timeout so nginx never
    # outlives the worker (a killed worker would leave a stale RUNNING job).
    location / {
        proxy_pass http://sticker_backend;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
