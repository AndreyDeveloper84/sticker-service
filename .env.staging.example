# Staging environment template. Copy to .env.staging on the server and fill in
# real values there. NEVER commit .env.staging — placeholders only below.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
# Comma-separated hostnames, e.g. staging.example.com
DJANGO_ALLOWED_HOSTS=staging.example.com
# Comma-separated origins with scheme, e.g. https://staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
# Primary staging hostname; also used by the nginx template
STAGING_DOMAIN=staging.example.com

# --- PostgreSQL (internal to the compose network, never published) ---
POSTGRES_DB=stickers_staging
POSTGRES_USER=stickers_staging
POSTGRES_PASSWORD=change-me-strong-random-password

# --- Gunicorn (optional) ---
GUNICORN_WORKERS=3

# --- Telegram ---
TELEGRAM_BOT_TOKEN=placeholder-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=placeholder-telegram-webhook-secret

# --- OpenAI ---
OPENAI_API_KEY=placeholder-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional images.edit parameters (DRF-2052 QC follow-up). Unset = not sent
# (current behaviour). Allowed: SIZE 1024x1024|1024x1536|1536x1024|auto;
# BACKGROUND transparent|opaque|auto; OUTPUT_FORMAT png|webp|jpeg (QC accepts
# png/webp only). Invalid values fail closed at provider start.
#OPENAI_IMAGE_SIZE=1024x1024
#OPENAI_IMAGE_BACKGROUND=transparent
#OPENAI_IMAGE_OUTPUT_FORMAT=png
# Image provider selection (DRF-2072): openai (default, paid production,
# reference-based) | nodule (EXPERIMENTAL text-to-image only; personalised
# preview/revision/full generation fails closed). No fallback between them.
IMAGE_PROVIDER=openai
# Nodule credentials are separate from OPENAI_API_KEY and never shared.
NODULE_IMAGE_API_KEY=placeholder-nodule-image-api-key
NODULE_IMAGE_BASE_URL=
NODULE_IMAGE_MODEL=gpt-image-2

# --- MAX ---
MAX_BOT_TOKEN=placeholder-max-bot-token
MAX_WEBHOOK_SECRET=placeholder-max-webhook-secret
# YooKassa (MAX channel payments). Real secrets go into .env.staging on the VPS.
YOOKASSA_SHOP_ID=placeholder-yookassa-shop-id
YOOKASSA_SECRET_KEY=placeholder-yookassa-secret-key
YOOKASSA_RETURN_URL=https://staging.example.com/payment/return
# Optional API base override for smoke tests; defaults to https://api.yookassa.ru/v3
# YOOKASSA_API_BASE=

# --- Telegram outbound transport (optional; defaults = direct api.telegram.org) ---
# Bot API compatible relay base; keep empty for direct mode
TELEGRAM_API_ORIGIN=
# File download origin; defaults to TELEGRAM_API_ORIGIN
TELEGRAM_FILE_ORIGIN=
# Generic outbound proxy applied to ALL Telegram traffic (JSON, multipart, downloads)
# e.g. http://user:password@proxy-host:3128 — credentials only here, never in code
TELEGRAM_PROXY_URL=
# Centralized outbound proxy pool for geo-blocked APIs (Telegram, OpenAI).
# Used only when TELEGRAM_PROXY_URL is empty. JSON list, credentials in URLs:
# OUTBOUND_PROXY_URLS_JSON=["http://user:password@proxy-a:3128","http://user:password@proxy-b:3128"]
OUTBOUND_PROXY_ENABLED=false
OUTBOUND_PROXY_URLS_JSON=
OUTBOUND_PROXY_COOLDOWN_SECONDS=60
