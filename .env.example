DJANGO_SECRET_KEY=example-not-a-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=stickers
POSTGRES_USER=stickers
POSTGRES_PASSWORD=local-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Telegram outbound transport (optional; defaults = direct api.telegram.org)
TELEGRAM_API_ORIGIN=
TELEGRAM_FILE_ORIGIN=
TELEGRAM_PROXY_URL=
# Centralized outbound proxy pool for geo-blocked APIs (Telegram, OpenAI).
# Used only when TELEGRAM_PROXY_URL is empty. JSON list, credentials in URLs:
# OUTBOUND_PROXY_URLS_JSON=["http://user:password@proxy-a:3128","http://user:password@proxy-b:3128"]
OUTBOUND_PROXY_ENABLED=false
OUTBOUND_PROXY_URLS_JSON=
OUTBOUND_PROXY_COOLDOWN_SECONDS=60
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional images.edit parameters (DRF-2052 QC follow-up). Unset = not sent
# (current behaviour). Allowed: SIZE 1024x1024|1024x1536|1536x1024|auto;
# BACKGROUND transparent|opaque|auto; OUTPUT_FORMAT png|webp|jpeg (QC accepts
# png/webp only). Invalid values fail closed at provider start.
#OPENAI_IMAGE_SIZE=1024x1024
#OPENAI_IMAGE_BACKGROUND=transparent
#OPENAI_IMAGE_OUTPUT_FORMAT=png
# input_fidelity high|low (gpt-image edits): "high" keeps the face from the
# reference photos closer (DRF-2080 likeness). Unset = API default.
#OPENAI_IMAGE_INPUT_FIDELITY=high
# QC format normalization (DRF-2076): fit every FINAL asset into 512x512
# (aspect kept, alpha preserved but never invented) before automated checks.
# Default on; set 0 to roll back to raw provider output without a deploy.
#QC_NORMALIZE_FINAL_ASSETS=1
# Image provider selection (DRF-2072): openai (default, paid production,
# reference-based) | nodule (EXPERIMENTAL text-to-image only; personalised
# preview/revision/full generation fails closed). No fallback between them.
IMAGE_PROVIDER=openai
# Nodule credentials are separate from OPENAI_API_KEY and never shared.
NODULE_IMAGE_API_KEY=
NODULE_IMAGE_BASE_URL=
NODULE_IMAGE_MODEL=gpt-image-2
# YooKassa (MAX channel payments). Real secrets live only in the server .env.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
# Optional API base override for tests/staging; defaults to https://api.yookassa.ru/v3
YOOKASSA_API_BASE=

# Pilot Budget Guard (DRF-2086). Enforced inside the generation services
# before any provider call (every billable path, console or not).
# Semantics: unset = default (day/month unlimited, per-order 15, per-slot 3);
# explicit 0 = unlimited; any other non-integer / negative value = INVALID →
# every billable action fails closed with a Russian message until fixed.
PILOT_MAX_IMAGE_CALLS_PER_DAY=
PILOT_MAX_IMAGE_CALLS_PER_MONTH=
PILOT_MAX_IMAGE_CALLS_PER_ORDER=
PILOT_MAX_FULL_ATTEMPTS_PER_SLOT=
# Tariff per image call (DRF-2111): snapshotted into every new GenerationJob at
# attempt time (immutable); unset → new jobs get cost_source=UNKNOWN (no default
# price). Optional label for the tariff version (default "<price>@<date>").
# PILOT_IMAGE_CALL_COST_USD was removed in DRF-2111 (it re-priced history).
PILOT_IMAGE_CALL_COST_RUB=
PILOT_IMAGE_PRICING_VERSION=
# Token pricing (owner GO 2026-09-20, docs/PRICING-gpt-image-2-token-rates-2026-09-20.md):
# the three USD-per-1M rates are snapshotted into every new job (immutable) and
# the cost is estimated after the answer from the actual usage (cost_source=
# ESTIMATED). All three rates required (invalid/missing → UNKNOWN, warning);
# takes precedence over PILOT_IMAGE_CALL_COST_RUB. FX is set by the owner (no
# lookup): without it the USD estimate stays and RUB is unknown.
PILOT_TOKEN_PRICING_MODEL=gpt-image-2
PILOT_TOKEN_PRICING_VERSION=openai-pricing@2026-09-20
PILOT_TEXT_INPUT_USD_PER_1M=
PILOT_IMAGE_INPUT_USD_PER_1M=
PILOT_IMAGE_OUTPUT_USD_PER_1M=
PILOT_FX_USD_RUB=
PILOT_FX_DATE=
PILOT_FX_SOURCE=
# Operator rate per hour (DRF-2111 PR-B): snapshotted into every manual work
# log at logging time (immutable); unset → manual cost "не настроено" (not 0).
PILOT_OPERATOR_COST_PER_HOUR_RUB=
PILOT_OPERATOR_RATE_VERSION=
# Telegram sticker set after delivery (DRF-2163): the customer's set is named
# <prefix>_<user_id>_by_<bot username>; the username comes from getMe unless
# set here. Both optional.
TELEGRAM_BOT_USERNAME=
TELEGRAM_STICKER_SET_PREFIX=sticks
